# Copy this file to ".env" and fill in a key to switch on virtual try-on.
# The .env file is read automatically when the server starts.

# ---- Recommended: Google Gemini (multi-garment looks + styling instructions) ----
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (default: gemini-2.5-flash-image)
# GEMINI_MODEL=gemini-2.5-flash-image

# ---- Alternative: Replicate IDM-VTON (single garment only, no instructions) ----
# Get a token at https://replicate.com/account/api-tokens
# REPLICATE_API_TOKEN=

# Force a specific engine (default picks Gemini if its key is set, else Replicate)
# TRYON_PROVIDER=gemini
